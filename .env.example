# MODE=mock (démo sans compte) ou live (API Swan sandbox/prod)
MODE=mock
PORT=3000
SWAN_CLIENT_ID=
SWAN_CLIENT_SECRET=
SWAN_API_URL=https://api.swan.io/sandbox-partner/graphql
SWAN_OAUTH_URL=https://oauth.swan.io/oauth2/token
SWAN_WEBHOOK_SECRET=
APP_URL=http://localhost:3000

# Gmail de la boîte opérations « dépôt de capital » (Google Workspace). Sans ces 4 valeurs : Gmail simulé.
# Jeton : GMAIL_CLIENT_ID=… GMAIL_CLIENT_SECRET=… node scripts/gmail-auth.mjs
GMAIL_ADDRESS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Facultatif : emails relevés (par défaut : in:inbox newer_than:7d -from:me)
GMAIL_QUERY=
